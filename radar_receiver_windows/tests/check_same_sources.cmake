# The receiver exists twice, as the CLion projects radar_receiver_windows and
# radar_receiver_linux: their src, tests, tools and config folders must be
# the same, so that every change is in both. Run by ctest (test same_sources):
#   cmake -DA=<this project> -DB=<the other one> -P check_same_sources.cmake
set(diffs "")
foreach(dir src tests tools config)
    file(GLOB_RECURSE fa RELATIVE "${A}" "${A}/${dir}/*")
    file(GLOB_RECURSE fb RELATIVE "${B}" "${B}/${dir}/*")
    foreach(f IN LISTS fa)
        if(NOT EXISTS "${B}/${f}")
            list(APPEND diffs "only in ${A}: ${f}")
        else()
            execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${A}/${f}" "${B}/${f}" RESULT_VARIABLE r)
            if(NOT r EQUAL 0)
                list(APPEND diffs "different: ${f}")
            endif()
        endif()
    endforeach()
    foreach(f IN LISTS fb)
        if(NOT EXISTS "${A}/${f}")
            list(APPEND diffs "only in ${B}: ${f}")
        endif()
    endforeach()
endforeach()
if(diffs)
    list(JOIN diffs "\n  " text)
    message(FATAL_ERROR "radar_receiver_windows and radar_receiver_linux differ (apply the change to both):\n  ${text}")
endif()
message(STATUS "src, tests, tools and config are the same in ${A} and ${B}")
